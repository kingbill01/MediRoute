# Configuration de la base de données
# Pour le développement local avec PostgreSQL
DATABASE_URL="postgresql://mediroute:mediroute@localhost:5432/mediroute?schema=public"

# Pour la production avec Azure Cosmos DB (optionnel)
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE_ID=mediroute

# Type de base de données (postgres ou cosmos)
DB_TYPE=postgres

# Configuration JWT — générer avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_openssl_rand_base64_48
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# Configuration serveur
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Configuration CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Azure Maps API (pour la géolocalisation)
AZURE_MAPS_KEY=your-azure-maps-subscription-key

# Configuration email (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Azure Blob Storage (pour les fichiers médicaux)
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=medical-documents

# Configuration socket.io
SOCKET_PORT=5001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
